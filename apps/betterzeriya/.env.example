# Required for session-ID access on Vercel. Connect Upstash Redis and set these
# server-only variables in the Vercel project, then redeploy.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL and KV_REST_API_TOKEN are also supported.
# Local Node development uses memory when neither pair is configured.
