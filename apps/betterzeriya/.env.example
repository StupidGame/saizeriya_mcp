# Recommended for reliable session-ID access across Vercel instances. Connect
# Upstash Redis and set both server-only variables, then redeploy.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL and KV_REST_API_TOKEN are also supported.
# Browser ordering and local Node development use snapshots and process-local
# memory when neither pair is configured.
